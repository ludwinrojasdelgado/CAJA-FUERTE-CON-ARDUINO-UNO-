#include <Wire.h>
#include <LiquidCrystal_I2C.h>
#include <Keypad.h>
#include <Servo.h>

LiquidCrystal_I2C lcd(0x27, 16, 2);

Servo cerrojo;
const int pinServo = 10;
const int anguloCerrado = 0;
const int anguloAbierto = 90;

const byte FILAS = 4;
const byte COLUMNAS = 4;

char teclas[FILAS][COLUMNAS] = {
  {'1', '2', '3', 'A'},
  {'4', '5', '6', 'B'},
  {'7', '8', '9', 'C'},
  {'*', '0', '#', 'D'}
};

byte pinesFilas[FILAS] = {9, 8, 7, 6};
byte pinesColumnas[COLUMNAS] = {5, 4, 3, 2};

Keypad teclado = Keypad(makeKeymap(teclas), pinesFilas, pinesColumnas, FILAS, COLUMNAS);

const int buzzer = 11;
const int ledRojo = 12;
const int ledVerde = 13;

String claveActual = "1234";
String claveIngresada = "";

int intentosFallidos = 0;
const int maxIntentos = 3;
const int tiempoBloqueoSegundos = 30; 
const int tiempoAutoCierreSegundos = 30;

bool puertaAbierta = false;
unsigned long tiempoApertura = 0; 
bool modoCambioClave = false;
bool pasoVerificarAnterior = false;

void setup() {
  pinMode(buzzer, OUTPUT);
  pinMode(ledRojo, OUTPUT);
  pinMode(ledVerde, OUTPUT);

  digitalWrite(buzzer, LOW);
  setRGB(0, 0);

  cerrojo.attach(pinServo);
  cerrojo.write(anguloCerrado);

  lcd.init();
  lcd.backlight();

  mostrarPantallaInicio();
}

void loop() {
  if (puertaAbierta) {
    if (millis() - tiempoApertura >= (tiempoAutoCierreSegundos * 1000UL)) {
      cerrarCaja();
    }
  }

  char tecla = teclado.getKey();

  if (tecla) {
    tone(buzzer, 1500, 50);

    if (puertaAbierta) {
      if (tecla == '*') {
        cerrarCaja();
      }
      return; 
    }

    if (modoCambioClave) {
      if (tecla == '*') {
        claveIngresada = "";
        actualizarPantallaDinamica("  CANCELADO   ", "");
        delay(1000);
        modoCambioClave = false;
        pasoVerificarAnterior = false;
        mostrarPantallaInicio();
      }
      else if (tecla == '#') {
        if (claveIngresada.length() > 0 && claveIngresada.length() <= 8) {
          if (!pasoVerificarAnterior) {
            if (claveIngresada == claveActual) {
              pasoVerificarAnterior = true;
              claveIngresada = "";
              actualizarPantallaDinamica(" NUEVA CLAVE: ", "");
            } else {
              tone(buzzer, 300, 400);
              actualizarPantallaDinamica("CLAVE INCORRECTA", "");
              delay(1500);
              modoCambioClave = false;
              pasoVerificarAnterior = false;
              mostrarPantallaInicio();
            }
          } else {
            claveActual = claveIngresada;
            tone(buzzer, 1200, 100);
            delay(100);
            tone(buzzer, 1800, 200);
            
            actualizarPantallaDinamica("CLAVE CAMBIADA!", "");
            delay(2000);
            modoCambioClave = false;
            pasoVerificarAnterior = false;
            mostrarPantallaInicio();
          }
        }
      }
      else {
        if (claveIngresada.length() < 8) {
          claveIngresada += tecla;
          actualizarPantallaCentrada();
        }
      }
      return;
    }

    if (tecla == 'A') {
      modoCambioClave = true;
      pasoVerificarAnterior = false;
      claveIngresada = "";
      actualizarPantallaDinamica(" CLAVE ACTUAL: ", "");
    }
    else if (tecla == '*') {
      claveIngresada = "";
      actualizarPantallaCentrada();
    }
    else if (tecla == '#') {
      if (claveIngresada.length() > 0) {
        verificarClave();
      }
    }
    else {
      if (claveIngresada.length() < 8) {
        claveIngresada += tecla;
        actualizarPantallaCentrada();
      }
    }
  }
}

void mostrarPantallaInicio() {
  setRGB(1, 1); 
  lcd.clear();
  lcd.setCursor(0, 0);
  lcd.print("CLAVE DE ACCESO:");
  lcd.setCursor(0, 1);
  lcd.print("                ");
}

void actualizarPantallaCentrada() {
  lcd.setCursor(0, 1);
  lcd.print("                ");
  
  int inicio = (16 - claveIngresada.length()) / 2;
  lcd.setCursor(inicio, 1);
  
  for (int i = 0; i < claveIngresada.length(); i++) {
    lcd.print("*");
  }
}

void actualizarPantallaDinamica(String linea1, String linea2) {
  lcd.clear();
  lcd.setCursor(0, 0);
  lcd.print(linea1);
  lcd.setCursor(0, 1);
  
  int inicio = (16 - claveIngresada.length()) / 2;
  lcd.setCursor(inicio, 1);
  for (int i = 0; i < claveIngresada.length(); i++) {
    lcd.print("*");
  }
}

void verificarClave() {
  if (claveIngresada == claveActual) {
    intentosFallidos = 0;
    setRGB(0, 1);

    lcd.clear();
    lcd.setCursor(0, 0);
    lcd.print("ACCESO CONCEDIDO");
    lcd.setCursor(0, 1);
    lcd.print("*:CERRAR RAPIDO");

    tone(buzzer, 1000, 100);
    delay(120);
    tone(buzzer, 2000, 200);

    cerrojo.write(anguloAbierto);
    puertaAbierta = true;
    tiempoApertura = millis(); 
    claveIngresada = "";
  } 
  else {
    intentosFallidos++;
    setRGB(1, 0);

    lcd.clear();
    lcd.setCursor(0, 0);
    lcd.print("CLAVE INCORRECTA");
    lcd.setCursor(0, 1);
    lcd.print("INTENTOS: ");
    lcd.print(intentosFallidos);
    lcd.print("/");
    lcd.print(maxIntentos);

    tone(buzzer, 300, 500);
    delay(1500);

    claveIngresada = "";

    if (intentosFallidos >= maxIntentos) {
      bloquearSistema();
    } else {
      mostrarPantallaInicio();
    }
  }
}

void cerrarCaja() {
  cerrojo.write(anguloCerrado);
  puertaAbierta = false;
  tone(buzzer, 800, 150);
  mostrarPantallaInicio();
}

void bloquearSistema() {
  setRGB(1, 0); 
  lcd.clear();
  lcd.setCursor(0, 0);
  lcd.print("SISTEMA BLOQUEADO");

  for (int i = tiempoBloqueoSegundos; i > 0; i--) {
    lcd.setCursor(0, 1);
    lcd.print("ESPERE: ");
    if (i < 10) lcd.print("0");
    lcd.print(i);
    lcd.print(" Seg   ");

    tone(buzzer, 800, 100); 
    delay(1000);
  }

  intentosFallidos = 0;
  mostrarPantallaInicio();
}

void setRGB(int rojo, int verde) {
  digitalWrite(ledRojo, rojo ? HIGH : LOW);
  digitalWrite(ledVerde, verde ? HIGH : LOW);
}
